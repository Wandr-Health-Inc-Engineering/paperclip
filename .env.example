DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- Tethr -------------------------------------------------------------
# Live Claude calls for agents (leave blank to use the deterministic mock)
ANTHROPIC_API_KEY=
# The "work" model — chat answers, plans, drafts, vision (default claude-sonnet-5)
TETHR_CLAUDE_MODEL=
# The cheap routing model — classify/plan hops (default claude-haiku-4-5)
TETHR_CLAUDE_FAST_MODEL=
# LLM backend: "api" (default, uses ANTHROPIC_API_KEY) or "claude-code" (drives
# the local Claude Code CLI on your personal Claude Pro/Max subscription — no API
# key, billed to your plan). Requires the `claude` CLI installed + logged in.
TETHR_LLM_BACKEND=
# Claude Code backend models (aliases opus|sonnet|haiku or full ids). Defaults:
# work=sonnet (generate/agentic), fast=haiku (classify/plan). Set opus for max quality.
TETHR_CLAUDE_CODE_MODEL=
TETHR_CLAUDE_CODE_FAST_MODEL=
# Optional: claude binary path, per-call timeout ms, agentic turn cap.
TETHR_CLAUDE_CODE_BIN=
TETHR_CLAUDE_CODE_TIMEOUT_MS=
TETHR_CLAUDE_CODE_MAX_TURNS=
# Path to the /tethr spec bundle (agent ROLE/ROUTING markdown). When blank,
# the seeder generates spec files from the vendored org spec instead.
TETHR_BUNDLE_PATH=
# Set to false to skip auto-seeding the Wandr Growth company at startup
TETHR_AUTOSEED=
# Read-only public web fetching for agent tools (CDC RSS, web pages). Off = fixtures.
TETHR_LIVE_FETCH=
# Set to false to stop "request changes" from auto-triggering an agent revision
TETHR_AUTO_REVISE=
# Shared-workspace mirror (v1): absolute path to a Google Drive desktop-synced
# folder (e.g. "~/Library/CloudStorage/GoogleDrive-<acct>/My Drive/00 Tethr").
# Published deliverables are projected there as files; empty = mirror off.
TETHR_MIRROR_DIR=
# Overseer roster (optional seed): who gets Slack-DM'd for each role. Also
# editable in-app on Settings. Slack member IDs (U…) — Slack profile → Copy member ID.
TETHR_OVERSEER_TECH_NAME=
TETHR_OVERSEER_TECH_SLACK_ID=
TETHR_OVERSEER_EXEC_NAME=
TETHR_OVERSEER_EXEC_SLACK_ID=
TETHR_OVERSEER_GROWTH_NAME=
TETHR_OVERSEER_GROWTH_SLACK_ID=
# Tethr Drive bytes (local provider). Defaults to ~/.paperclip/storage
PAPERCLIP_STORAGE_LOCAL_DIR=./.tethr-data/storage
