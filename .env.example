DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- Tethr -------------------------------------------------------------
# Live Claude calls for agents (leave blank to use the deterministic mock)
ANTHROPIC_API_KEY=
# Optional override for the live model
TETHR_CLAUDE_MODEL=
# Path to the /tethr spec bundle (agent ROLE/ROUTING markdown). When blank,
# the seeder generates spec files from the vendored org spec instead.
TETHR_BUNDLE_PATH=
# Set to false to skip auto-seeding the Wandr Growth company at startup
TETHR_AUTOSEED=
# Read-only public web fetching for agent tools (CDC RSS, web pages). Off = fixtures.
TETHR_LIVE_FETCH=
# Set to false to stop "request changes" from auto-triggering an agent revision
TETHR_AUTO_REVISE=
# Tethr Drive bytes (local provider). Defaults to ~/.paperclip/storage
PAPERCLIP_STORAGE_LOCAL_DIR=./.tethr-data/storage
